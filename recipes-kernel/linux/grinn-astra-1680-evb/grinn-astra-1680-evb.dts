/dts-v1/;

#include "grinn-astra-1680.dtsi"

/ {
	model = "Grinn Astra 1680 evb";
	compatible = "syna,dolphin-evk", "syna,dolphin";

	leds {
		compatible = "gpio-leds";
		status = "okay";

		ir_led_en1: led0 {
			gpios = <&portb 5 GPIO_ACTIVE_HIGH>;
			default-state = "off";
			pinctrl-0 = <&ir_led_en1_pmux>;
		};

		ir_led_en2: led1 {
			gpios = <&portb 4 GPIO_ACTIVE_HIGH>;
			default-state = "off";
			pinctrl-0 = <&ir_led_en2_pmux>;
		};
	};

	regulators {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <0>;

		usb3_vbus: usb3_vbus {
			compatible = "regulator-fixed";
			regulator-min-microvolt = <5000000>;
			regulator-max-microvolt = <5000000>;
			regulator-name = "usb3-vbus";
			enable-active-high;
			gpio = <&portb 12 GPIO_ACTIVE_HIGH>;
		};
	};
};

&gmac0 {
	status = "okay";
	pinctrl-0 = <&gmac0_pmux>, <&gmac_gpio_pmux>;
	pinctrl-names = "default";
	phy-handle = <&phy0>;
	phy-mode = "rgmii-id";
	snps,reset-gpio = <&portd 8 GPIO_ACTIVE_HIGH>;
	snps,reset-delays-us = <0 10000 50000>;
	snps,reset-active-low;
};

&i2cdemux3_i2c {
	expander0: gpio@43 {
		compatible = "fcs,fxl6408";
		reg = <0x43>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names = "PWR_SOC_VCORE_EN", "", "VDDM_ON", "VDDM_LPQ_OFF",
				  "STAND_BY_EN", "", "", "";
	};
};

&mdio0 {
	phy0: ethernet-phy@0 {
		reg = <0>;
		compatible = "ethernet-phy-ieee802.3-c22";
		device_type = "ethernet-phy";
	};
};

&pinctrl {
	gpio_port_d: gpio-port-d {
		groups = "SM_SPI2_SS1n";
		function = "gpio";
		drive-strength = <7>;
	};

	ir_led_en1_pmux: ir-led-en1-pmux {
		groups = "STS1_SD";
		function = "gpio";
	};

	ir_led_en2_pmux: ir-led-en2-pmux {
		groups = "STS1_VALD";
		function = "gpio";
	};

	usb3_vbus_pmux: usb3_vbus_pmux {
		groups = "SDIO_WP";
		function = "gpio";
	};
};

&portb {
	gpio-line-names =
		"", "", "", "", "IR_LED_EN2", "IR_LED_EN1", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "";
};

&portd {
	pinctrl-0 = <&gpio_port_d>;

	gpio-line-names =
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"LED_ENn", "PWR_ENn", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "";
};

&sm_gpio0 {
	pinctrl-0 = <&levelshift_pmux>, <&sm_gpio_pmux>;
};

&sm_pinctrl {
	sm_gpio_pmux: sm_gpio-pmux {
		groups = "SM_SPI2_SS0n";
		function = "gpio";
	};
};

&xhci0 {
	status = "okay";
	vbus-supply = <&usb3_vbus>;
	pinctrl-0 = <&usb3_vbus_pmux>;
	pinctrl-names = "default";
};
