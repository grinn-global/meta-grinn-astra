/dts-v1/;

#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

#include "grinn-astra-1680.dtsi"

/ {
	model = "Grinn Astra 1680 evb";
	compatible = "syna,dolphin-evk", "syna,dolphin";

	bt_reg_on: bt_reg_on {
		compatible = "syna,rfkill";
		status = "okay";
		bt-power-gpio = <&porta 13 GPIO_ACTIVE_HIGH>;
		pinctrl-0 = <&bt_reg_on_pmux>;
		pinctrl-names = "default";
	};

	leds {
		compatible = "gpio-leds";
		status = "okay";
		pinctrl-0 = <&ir_led_en1_pmux>, <&ir_led_en2_pmux>,
			    <&led0_pmux>, <&led1_pmux>, <&led2_pmux>, <&led3_pmux>;
		pinctrl-names = "default";

		ir_led0: led-ir-0 {
			gpios = <&portb 5 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_IR>;
			function = LED_FUNCTION_TORCH;
			function-enumerator = <0>;
			default-state = "off";
		};

		ir_led1: led-ir-1 {
			gpios = <&portb 4 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_IR>;
			function = LED_FUNCTION_TORCH;
			function-enumerator = <1>;
			default-state = "off";
		};

		status_led0: status-led-0 {
			gpios = <&porta 18 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_POWER;
			linux,default-trigger = "default-on";
			default-state = "off";
		};

		status_led1: status-led-1 {
			gpios = <&porta 19 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_HEARTBEAT;
			linux,default-trigger = "heartbeat";
			default-state = "off";
		};

		status_led2: status-led-2 {
			gpios = <&porta 21 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_DISK_ACTIVITY;
			linux,default-trigger = "mmc0";
			default-state = "off";
		};

		status_led3: status-led-3 {
			gpios = <&porta 20 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_FAULT;
			linux,default-trigger = "panic";
			default-state = "off";
		};
	};

	keys {
		compatible = "gpio-keys";
		status = "okay";
		pinctrl-0 = <&button_pmux>;
		pinctrl-names = "default";

		user-button {
			label = "Enter Button";
			linux,code = <KEY_ENTER>;
			gpios = <&porta 15 GPIO_ACTIVE_LOW>;
			debounce-interval = <50>;
		};
	};

	regulators {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <0>;

		usb3_vbus: usb3_vbus {
			compatible = "regulator-fixed";
			regulator-min-microvolt = <5000000>;
			regulator-max-microvolt = <5000000>;
			regulator-name = "usb3-vbus";
			enable-active-high;
			gpio = <&portb 12 GPIO_ACTIVE_HIGH>;
			pinctrl-0 = <&usb3_vbus_pmux>;
			pinctrl-names = "default";
		};
	};
};

&avio {
	status = "okay";
	pinctrl-0 = <&hdmitx5v_pmux>;
	pinctrl-names = "default";

	vpp {
		hdtx5v-gpio = <&portb 6 GPIO_ACTIVE_HIGH>;
	};
};

&avio_pinctrl {
	bt_reg_on_pmux: bt-reg-on-pmux {
		groups = "I2S2_LRCKIO";
		function = "gpio";
	};

	button_pmux: button-pmux {
		groups = "I2S1_DO3";
		function = "gpio";
	};

	led0_pmux: led0-pmux {
		groups = "I2S1_MCLK";
		function = "gpio";
	};

	led1_pmux: led1-pmux {
		groups = "I2S1_DO0";
		function = "gpio";
	};

	led2_pmux: led2-pmux {
		groups = "I2S1_LRCKIO";
		function = "gpio";
	};

	led3_pmux: led3-pmux {
		groups = "I2S1_BCLKIO";
		function = "gpio";
	};

	pcie_rst_pmux: pcie-rst-pmux {
		groups = "SPDIFO";
		function = "gpio";
	};
};

&gmac0 {
	status = "okay";
	pinctrl-0 = <&gmac0_pmux>, <&gmac_gpio_pmux>;
	pinctrl-names = "default";
	phy-handle = <&phy0>;
	phy-mode = "rgmii-id";
	snps,reset-gpio = <&portd 8 GPIO_ACTIVE_HIGH>;
	snps,reset-delays-us = <0 10000 50000>;
	snps,reset-active-low;
};

&i2cdemux3_i2c {
	expander0: gpio@43 {
		compatible = "fcs,fxl6408";
		reg = <0x43>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names = "PWR_SOC_VCORE_EN", "", "VDDM_ON", "VDDM_LPQ_OFF",
				  "STAND_BY_EN", "", "", "";
	};
};

&mdio0 {
	phy0: ethernet-phy@0 {
		reg = <0>;
		compatible = "ethernet-phy-ieee802.3-c22";
		device_type = "ethernet-phy";
	};
};

&pcie0 {
	reset-gpios = <&porta 14 GPIO_ACTIVE_LOW>;
	pinctrl-0 = <&pcie_rst_pmux>;
	pinctrl-names = "default";
};

&pinctrl {
	hdmitx5v_pmux: hdmitx5v-pmux {
		groups = "STS1_SOP";
		function = "gpio";
	};

	ir_led_en1_pmux: ir-led-en1-pmux {
		groups = "STS1_SD";
		function = "gpio";
	};

	ir_led_en2_pmux: ir-led-en2-pmux {
		groups = "STS1_VALD";
		function = "gpio";
	};

	usb3_vbus_pmux: usb3_vbus_pmux {
		groups = "SDIO_WP";
		function = "gpio";
	};
};

&porta {
	gpio-line-names =
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "BT_REG_ON", "PCIE_RSTn", "BUTTONn",
		"", "", "LED0", "LED1", "LED3", "LED2", "", "",
		"", "", "", "", "", "", "", "";
};

&portb {
	gpio-line-names =
		"", "", "", "", "IR_LED_EN2", "IR_LED_EN1", "HDMI_TX_5V_EN", "",
		"", "", "", "", "USB3_EN", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "";
};

&portd {
	pinctrl-0 = <&led_en_pmux>, <&pwr_en_pmux>;
	pinctrl-names = "default";

	gpio-line-names =
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"LED_ENn", "PWR_ENn", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "";
};

&sm_pinctrl {
	led_en_pmux: led-en-pmux {
		groups = "SM_SPI2_SS1n";
		function = "gpio";
	};

	pwr_en_pmux: pwr-en-pmux {
		groups = "SM_SPI2_SS0n";
		function = "gpio";
	};
};

&xhci0 {
	status = "okay";
	vbus-supply = <&usb3_vbus>;
};
