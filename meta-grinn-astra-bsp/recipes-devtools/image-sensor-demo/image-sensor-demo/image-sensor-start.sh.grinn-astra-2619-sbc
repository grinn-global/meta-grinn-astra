#!/bin/sh

export XDG_RUNTIME_DIR=/var/run/user/0
export WAYLAND_DISPLAY=wayland-1

CSI0_DEV="none"
SINK="${1:-file}"
CAPTURE_PATH="/tmp/camera.avi"

usage() {
    echo "Usage: $0 [file|display]"
    echo "  file    (default) record to $CAPTURE_PATH"
    echo "  display preview on the Wayland compositor"
}

get_video_devices() {
    eval "$(v4l2-ctl --list-devices | awk '
        BEGIN { found = "" }
        /camera-video\.0\.0 \(platform:camera-video\.0\.0\):/ {
            found = "CSI0"
            next
        }
        /^[[:space:]]*\/dev\/video[0-9]+/ {
            if (found == "CSI0") {
                print "CSI0_DEV=" $1
                found = ""
            }
        }
    ')"
}

enable_sensor() {
    gpioset --toggle 0 CAM_GPIO0=1
    gpioset --toggle 0 CAM_GPIO1=1
}

start_pipeline() {
    if [ "$CSI0_DEV" = "none" ]; then
        echo "Video device not available - cannot start pipeline"
        exit 1
    fi

    CAPS='video/x-raw, format=NV12, width=640, height=480, framerate=30/1'

    case "$SINK" in
        file)
            gst-launch-1.0 -e v4l2src device="$CSI0_DEV" ! \
                "$CAPS" ! jpegenc ! avimux ! \
                filesink location="$CAPTURE_PATH"
            ;;
        display)
            gst-launch-1.0 v4l2src device="$CSI0_DEV" ! \
                "$CAPS" ! waylandsink
            ;;
        *)
            usage
            exit 1
            ;;
    esac
}

get_video_devices

echo "CSI0_DEV=$CSI0_DEV"

enable_sensor
start_pipeline
