#!/bin/sh

export XDG_RUNTIME_DIR=/var/run/user/0
export WAYLAND_DISPLAY=wayland-1

CSI0_DEV="none"

get_video_devices() {
    eval "$(v4l2-ctl --list-devices | awk '
        BEGIN { found = "" }
        /camera-video\.0\.0 \(platform:camera-video\.0\.0\):/ {
            found = "CSI0"
            next
        }
        /^[[:space:]]*\/dev\/video[0-9]+/ {
            if (found == "CSI0") {
                print "CSI0_DEV=" $1
                found = ""
            }
        }
    ')"
}

enable_sensor() {
    gpioset $(gpiofind CAM_GPIO0)=1
    gpioset $(gpiofind CAM_GPIO1)=1
}

start_pipeline() {
    if [ "$CSI0_DEV" = "none" ]; then
        echo "Video device not available - cannot start pipeline"
        exit 1
    fi

    gst-launch-1.0 v4l2src device="$CSI0_DEV" ! \
        'video/x-raw, format=NV12, width=640, height=480, framerate=30/1' \
        ! waylandsink
}

get_video_devices

echo "CSI0_DEV=$CSI0_DEV"

enable_sensor
start_pipeline
