#!/bin/sh

export XDG_RUNTIME_DIR=/var/run/user/0
export WAYLAND_DISPLAY=wayland-1

CSI0_DEV="none"

get_video_devices() {
    eval "$(v4l2-ctl --list-devices | awk '
        BEGIN { found = "" }
        /vvcam-video\.0\.0 \(platform:vvcam-video\.0\.0\):/ {
            found = "CSI0"
            next
        }
        /^[[:space:]]*\/dev\/video[0-9]+/ {
            if (found == "CSI0") {
                print "CSI0_DEV=" $1
                found = ""
            }
        }
    ')"
}

enable_sensor() {
    gpioset `gpiofind CAM_POWER_EN`=1
    gpioset `gpiofind CAM_LED_EN`=1
}

start_pipeline() {
    local VIDEO_DEV="$CSI0_DEV"

    if [ "$VIDEO_DEV" = "none" ]; then
        echo "Video device not available - cannot start pipeline"
        exit 1
    fi

    gst-launch-1.0 v4l2src device="$VIDEO_DEV" ! \
        'video/x-raw, format=NV12, width=800, height=600, framerate=30/1' \
        ! waylandsink
}

get_video_devices

echo "CSI0_DEV=$CSI0_DEV"

enable_sensor
start_pipeline
