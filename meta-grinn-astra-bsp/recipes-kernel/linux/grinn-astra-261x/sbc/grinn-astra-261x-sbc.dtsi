#include <dt-bindings/gpio/gpio.h>

/ {
	aliases {
		ethernet0 = &ethernet0;
		ethernet1 = &ethernet1;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	mdio-demux {
		compatible = "mdio-demux";
		mux-controls = <&mux1 0>;
		mdio-parent-bus = <&mdio0>, <&mdio1>;
		#address-cells = <1>;
		#size-cells = <0>;

		mdio@0 {
			reg = <0x0>;
			#address-cells = <1>;
			#size-cells = <0>;

			ethernet_phy0: ethernet-phy@3 {
				reg = <3>;
				compatible = "ethernet-phy-ieee802.3-c22";
				device_type = "ethernet-phy";
				rxc-skew-ps = <1500>;
				rxdv-skew-ps = <420>;
				rxd0-skew-ps = <420>;
				rxd1-skew-ps = <420>;
				rxd2-skew-ps = <420>;
				rxd3-skew-ps = <420>;
				txc-skew-ps = <900>;
				txen-skew-ps = <420>;
				txd0-skew-ps = <420>;
				txd1-skew-ps = <420>;
				txd2-skew-ps = <420>;
				txd3-skew-ps = <420>;
			};
		};

		mdio@1 {
			reg = <0x1>;
			#address-cells = <1>;
			#size-cells = <0>;

			ethernet_phy1: ethernet-phy@2 {
				reg = <2>;
				compatible = "ethernet-phy-ieee802.3-c22";
				device_type = "ethernet-phy";
				rxc-skew-ps = <1500>;
				rxdv-skew-ps = <420>;
				rxd0-skew-ps = <420>;
				rxd1-skew-ps = <420>;
				rxd2-skew-ps = <420>;
				rxd3-skew-ps = <420>;
				txc-skew-ps = <900>;
				txen-skew-ps = <420>;
				txd0-skew-ps = <420>;
				txd1-skew-ps = <420>;
				txd2-skew-ps = <420>;
				txd3-skew-ps = <420>;
			};
		};
	};

	soc {
		eth0_txc_90deg: syscon@f7e10a18 {
			compatible = "syscon";
			reg = <0xf7e10a18 0x4>;
		};

		eth1_txc_90deg: syscon@f7e10a3c {
			compatible = "syscon";
			reg = <0xf7e10a3c 0x4>;
		};
	};
};

&ethernet0 {
	status = "okay";
	pinctrl-0 = <&eth_mdio_pmux>, <&eth0_pmux>, <&eth0_phy_rst_pmux>, <&eth0_phy_int_pmux>;
	pinctrl-names = "default";
	phy-handle = <&ethernet_phy0>;
	phy-mode = "rgmii-id";
	snps,reset-gpio = <&porta 16 GPIO_ACTIVE_LOW>;
	snps,reset-delays-us = <0 10000 50000>;
	syna,txc-90deg = <&eth0_txc_90deg>;

	mdio0: mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;
	};
};

&ethernet1 {
	status = "okay";
	pinctrl-0 = <&eth_mdio_pmux>, <&eth1_pmux>, <&eth1_phy_rst_pmux>, <&eth1_phy_int_pmux>;
	pinctrl-names = "default";
	phy-handle = <&ethernet_phy1>;
	phy-mode = "rgmii-id";
	snps,reset-gpio = <&porta 19 GPIO_ACTIVE_LOW>;
	snps,reset-delays-us = <0 10000 50000>;
	syna,txc-90deg = <&eth1_txc_90deg>;

	mdio1: mdio {
		compatible = "snps,dwmac-mdio";
		#address-cells = <1>;
		#size-cells = <0>;
	};
};

&mux1 {
	status = "okay";
};

&pdma1 {
	status = "okay";
};

&pinctrl {
	eth_mdio_pmux: eth-mdio-pmux {
		groups = "GPIO31", "GPIO32";
		function = "rgmii";
		drive-strength = <7>;
	};

	eth0_phy_int_pmux: eth0-phy-int-pmux {
		groups = "GPIO17";
		function = "gpio";
	};

	eth0_phy_rst_pmux: eth0-phy-rst-pmux {
		groups = "GPIO16";
		function = "gpio";
	};

	eth0_pmux: eth0-pmux {
		groups = "GPIO33", "GPIO34", "GPIO35", "GPIO36", "GPIO37", "GPIO38", "GPIO39", "GPIO40", "GPIO41", "GPIO42", "GPIO43", "GPIO44";
		function = "rgmii1";
		drive-strength = <7>;
	};

	eth1_phy_int_pmux: eth1-phy-int-pmux {
		groups = "GPIO18";
		function = "gpio";
	};

	eth1_phy_rst_pmux: eth1-phy-rst-pmux {
		groups = "GPIO19";
		function = "gpio";
	};

	eth1_pmux: eth1-pmux {
		groups = "GPIO48", "GPIO49", "GPIO50", "GPIO51", "GPIO52", "GPIO53", "GPIO54", "GPIO55", "GPIO56", "GPIO57", "GPIO58", "GPIO59";
		function = "rgmii2";
		drive-strength = <7>;
	};
};

&porta {
	gpio-line-names =
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"ETH1_RSTn", "ETH1_INTn", "ETH2_INTn", "ETH2_RSTn", "", "", "", "",
		"", "", "", "", "", "", "", "";
};

&uart0 {
	status = "okay";
};

&usb0 {
	status = "okay";
	dr_mode = "peripheral";
};

&usb_phy0 {
	status = "okay";
};

&usb1 {
	status = "okay";
	dr_mode = "host";
};

&usb_phy1{
	status = "okay";
};
