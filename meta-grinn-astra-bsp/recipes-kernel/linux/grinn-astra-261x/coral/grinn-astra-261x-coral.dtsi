#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	chosen {
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";
		status = "okay";

		user-button {
			pinctrl-names = "default";
			pinctrl-0 = <&user_button_pmux>;
			label = "Enter Button";
			linux,code = <KEY_ENTER>;
			gpios = <&portb 26 GPIO_ACTIVE_LOW>;
			debounce-interval = <50>;
		};
	};

	leds {
		compatible = "gpio-leds";
		status = "okay";

		status_led_blue: status-led-blue {
			pinctrl-names = "default";
			pinctrl-0 = <&led_1_pmux>;
			gpios = <&portc 14 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_DISK_ACTIVITY;
			linux,default-trigger = "mmc0";
			default-state = "off";
		};

		status_led_red: status-led-red {
			pinctrl-names = "default";
			pinctrl-0 = <&led_2_pmux>;
			gpios = <&portc 15 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_HEARTBEAT;
			linux,default-trigger = "heartbeat";
			default-state = "off";
		};
	};

	regulators {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <0>;

		usb1_vbus: usb1-vbus {
			compatible = "regulator-fixed";
			pinctrl-names = "default";
			pinctrl-0 = <&usb_host_pwr_en_pmux>;
			regulator-name = "usb1_vbus";
			regulator-min-microvolt = <5000000>;
			regulator-max-microvolt = <5000000>;
			gpio = <&portb 22 GPIO_ACTIVE_HIGH>;
			enable-active-high;
		};

		vmmc_sdhci2: vmmc-sdhci2 {
			compatible = "regulator-fixed";
			pinctrl-names = "default";
			pinctrl-0 = <&vmmc_sdhci2_pmux>;
			regulator-name = "vmmc_sdio";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			gpio = <&portb 21 GPIO_ACTIVE_HIGH>;
			enable-active-high;
			regulator-boot-on;
		};

		vqmmc_sdhci2: vqmmc-sdhci2 {
			compatible = "regulator-gpio";
			pinctrl-names = "default";
			pinctrl-0 = <&vqmmc_sdhci2_pmux>;
			regulator-name = "vqmmc_sdio";
			regulator-type = "voltage";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <3300000>;
			gpios = <&portb 23 GPIO_ACTIVE_HIGH>;
			enable-active-high;
			states = <1800000 0x0
				  3300000 0x1>;
		};
	};
};

&camera_video {
	status = "okay";
};

&csi {
	status = "okay";

	ports {
		port@0 {
			csi_input: endpoint@0 {
				remote-endpoint = <&cam_endpoint>;
			};
		};
	};
};

&i2c0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pmux>;
	clock-frequency = <100000>;
};

&i2c2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pmux>;
	clock-frequency = <100000>;
};

&i2c3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_pmux>;
	no-irq-suspend;
	clock-frequency = <100000>;

	camera: ov5647@36 {
		compatible = "ovti,ov5647";
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <&csi_gpio1_pmux>;
		reg = <0x36>;
		pwdn-gpios = <&porta 9 GPIO_ACTIVE_LOW>;
		clocks = <&osc>;
		rotation = <0>;
		orientation = <2>;

		port {
			cam_endpoint: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2>;
				clock-noncontinuous;
				remote-endpoint = <&csi_input>;
			};
		};
	};
};

&isp {
	status = "okay";
};

&mux0 {
	status = "okay";
};

&pinctrl {
	i2c2_pmux: i2c2-pmux {
		groups = "GPIO23", "GPIO24";
		function = "tw2";
		drive-strength = <7>;
	};

	i2c3_pmux: i2c3-pmux {
		groups = "GPIO27", "GPIO28";
		function = "tw3";
		drive-strength = <7>;
	};

	sdhci2_pmux: sdhci2-pmux {
		groups = "GPIO16", "GPIO17", "GPIO18", "GPIO19", "GPIO20", "GPIO21", "GPIO22";
		function = "sdio2";
		drive-strength = <7>;
	};

	usb_host_pwr_en_pmux: usb-host-pwr-en-pmux {
		groups = "GPIO54";
		function = "gpio";
	};

	user_button_pmux: user-button-pmux {
		groups = "GPIO58";
		function = "gpio";
	};

	vmmc_sdhci2_pmux: vmmc-sdhci2-pmux {
		groups = "GPIO53";
		function = "gpio";
	};

	vqmmc_sdhci2_pmux: vqmmc-sdhci2-pmux {
		groups = "GPIO55";
		function = "gpio";
	};
};

&porta {
	gpio-line-names =
		"", "", "", "", "", "", "", "",
		"", "CSI_GPIO0", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "";
};

&portb {
	gpio-line-names =
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "POWER_SOURCE", "",
		"", "", "", "USB_HOST_OCSn", "", "USD_PWR_EN", "USB_HOST_POWER_EN", "USD_VSEL",
		"", "", "USER_BUTTONn", "", "", "", "", "";
};

&portc {
	gpio-line-names =
		"", "", "", "", "", "VCORE_ONn", "", "",
		"", "", "", "", "", "", "LED_1", "LED_2";
};

&porte {
	gpio-line-names =
		"", "", "", "", "", "", "CSI_GPIO1", "";
};

&sdhci2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&sdhci2_pmux>;
	bus-width = <4>;
	no-mmc;
	disable-wp;
	cap-sd-highspeed;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	vmmc-supply = <&vmmc_sdhci2>;
	vqmmc-supply = <&vqmmc_sdhci2>;
	mux-states = <&mux0 0 3>;
};

&sm_pinctrl {
	csi_gpio1_pmux: csi-gpio1-pmux {
		groups = "SM_GPIO30";
		function = "gpio";
	};

	i2c0_pmux: i2c0-pmux {
		groups = "SM_GPIO37", "SM_GPIO38";
		function = "tw0";
		drive-strength = <7>;
	};

	led_1_pmux: led-1-pmux {
		groups = "SM_GPIO14";
		function = "gpio";
	};

	led_2_pmux: led-2-pmux {
		groups = "SM_GPIO15";
		function = "gpio";
	};
};

&uart0 {
	status = "okay";
};

&usb0 {
	status = "okay";
	dr_mode = "peripheral";
};

&usb_phy0 {
	status = "okay";
};

&usb1 {
	status = "okay";
	vbus-supply = <&usb1_vbus>;
	dr_mode = "host";
};

&usb_phy1 {
	status = "okay";
};
