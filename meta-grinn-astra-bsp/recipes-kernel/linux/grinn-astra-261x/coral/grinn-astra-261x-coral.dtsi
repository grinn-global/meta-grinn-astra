#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>

/ {
	chosen {
		stdout-path = "serial0:115200n8";
	};

	bt_reg_on: bt-reg-on {
		compatible = "syna,rfkill";
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <&w_disable2_pmux>;
		bt-power-gpio = <&portb 18 GPIO_ACTIVE_HIGH>;
	};

	keys {
		compatible = "gpio-keys";
		status = "okay";

		user-button {
			pinctrl-names = "default";
			pinctrl-0 = <&user_button_pmux>;
			label = "Enter Button";
			linux,code = <KEY_ENTER>;
			gpios = <&portb 26 GPIO_ACTIVE_LOW>;
			debounce-interval = <50>;
		};
	};

	leds {
		compatible = "gpio-leds";
		status = "okay";

		status_led_blue: status-led-blue {
			pinctrl-names = "default";
			pinctrl-0 = <&led_1_pmux>;
			gpios = <&portc 14 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_BLUE>;
			function = LED_FUNCTION_DISK_ACTIVITY;
			linux,default-trigger = "mmc0";
			default-state = "off";
		};

		status_led_red: status-led-red {
			pinctrl-names = "default";
			pinctrl-0 = <&led_2_pmux>;
			gpios = <&portc 15 GPIO_ACTIVE_HIGH>;
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_HEARTBEAT;
			linux,default-trigger = "heartbeat";
			default-state = "off";
		};
	};

	regulators {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <0>;

		usb1_vbus: usb1-vbus {
			compatible = "regulator-fixed";
			pinctrl-names = "default";
			pinctrl-0 = <&usb_host_pwr_en_pmux>;
			regulator-name = "usb1_vbus";
			regulator-min-microvolt = <5000000>;
			regulator-max-microvolt = <5000000>;
			gpio = <&portb 22 GPIO_ACTIVE_HIGH>;
			enable-active-high;
		};

		vmmc_sdhci2: vmmc-sdhci2 {
			compatible = "regulator-fixed";
			pinctrl-names = "default";
			pinctrl-0 = <&vmmc_sdhci2_pmux>;
			regulator-name = "vmmc_sdio";
			regulator-min-microvolt = <3300000>;
			regulator-max-microvolt = <3300000>;
			gpio = <&portb 21 GPIO_ACTIVE_HIGH>;
			enable-active-high;
			regulator-boot-on;
		};

		vqmmc_sdhci2: vqmmc-sdhci2 {
			compatible = "regulator-gpio";
			pinctrl-names = "default";
			pinctrl-0 = <&vqmmc_sdhci2_pmux>;
			regulator-name = "vqmmc_sdio";
			regulator-type = "voltage";
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <3300000>;
			gpios = <&portb 23 GPIO_ACTIVE_HIGH>;
			enable-active-high;
			states = <1800000 0x0
				  3300000 0x1>;
		};
	};

	sdhci1_pwrseq: sdhci1-pwrseq {
		compatible = "mmc-pwrseq-simple";
		pinctrl-names = "default";
		pinctrl-0 = <&w_disable1_pmux>;
		reset-gpios = <&portb 16 GPIO_ACTIVE_LOW>;
		post-power-on-delay-ms = <50>;
	};
};

&avio {
	status = "okay";
};

&camera_video {
	status = "okay";
};

&csi {
	status = "okay";

	ports {
		port@0 {
			csi_input: endpoint@0 {
				remote-endpoint = <&cam_endpoint>;
			};
		};
	};
};

&drm {
	status = "okay";

	dsi_panel {
		status = "okay";

		backlight = <&display>;
		compatible_panel="waveshare,13.3inch-4lane-panel";
		ACTIVE_WIDTH = <1920>;
		HFP = <88>;
		HSYNCWIDTH = <44>;
		HBP = <148>;
		ACTIVE_HEIGHT = <1080>;
		VFP = <4>;
		VSYNCWIDTH = <5>;
		VBP = <36>;
		FREQ = <148500>;
		bits_per_pixel = <24>;
		busformat = <0>;

		HTOTAL = <2200>;
		Lanes = /bits/ 8 <4>;
		Vid_mode = /bits/ 8 <2>;
		virtual_chan = /bits/ 8 <0>;
		Clk_Lane_Polarity = /bits/ 8 <0>;
		Data_Lane_Polarity = /bits/ 8 <0>;
		Recv_ack = /bits/ 8 <0>;
		Loosely_18 = /bits/ 8 <0>;
		H_polarity = /bits/ 8 <1>;
		V_Polarity = /bits/ 8 <1>;
		Data_Polarity = /bits/ 8 <1>;
		Eotp_tx = /bits/ 8 <1>;
		Eotp_rx = /bits/ 8 <0>;
		non-Continuous_clk = /bits/ 8 <0>;
		dpi_lp_cmd = /bits/ 8 <1>;
		Color_coding = /bits/ 8 <5>;
		Chunks = <0>;
		Null_Pkt = <0>;
		Byte_clk = <148500>;

		command = /bits/ 8 <0xFF  0x10 0x27  0x00  0x00>;
	};
};

&gpu {
	status = "okay";
};

&i2c0 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c0_pmux>;
	clock-frequency = <400000>;
	i2c-sda-hold-time-ns = <300>;
	i2c-sda-falling-time-ns = <250>;
	i2c-scl-falling-time-ns = <250>;
};

&i2c2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c2_pmux>;
	clock-frequency = <400000>;
	i2c-sda-hold-time-ns = <300>;
	i2c-sda-falling-time-ns = <250>;
	i2c-scl-falling-time-ns = <250>;
};

&i2c3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&i2c3_pmux>;
	no-irq-suspend;
	clock-frequency = <400000>;
	i2c-sda-hold-time-ns = <300>;
	i2c-sda-falling-time-ns = <250>;
	i2c-scl-falling-time-ns = <250>;

	camera: ov5647@36 {
		compatible = "ovti,ov5647";
		status = "okay";
		pinctrl-names = "default";
		pinctrl-0 = <&csi_gpio1_pmux>;
		reg = <0x36>;
		pwdn-gpios = <&porta 9 GPIO_ACTIVE_LOW>;
		clocks = <&osc>;
		rotation = <0>;
		orientation = <2>;

		port {
			cam_endpoint: endpoint {
				clock-lanes = <0>;
				data-lanes = <1 2>;
				clock-noncontinuous;
				remote-endpoint = <&csi_input>;
			};
		};
	};

	display: waveshare@45 {
		compatible = "waveshare,13.3inch-4lane-panel";
		status= "okay";
		reg = <0x45>;
	};
};

&isp {
	status = "okay";
};

&mux0 {
	status = "okay";
};

&pdma0 {
	status = "okay";
};

&pdma1 {
	status = "okay";
};

&pinctrl {
	i2c2_pmux: i2c2-pmux {
		groups = "GPIO23", "GPIO24";
		function = "tw2";
		drive-strength = <7>;
	};

	i2c3_pmux: i2c3-pmux {
		groups = "GPIO27", "GPIO28";
		function = "tw3";
		drive-strength = <7>;
	};

	sdhci2_pmux: sdhci2-pmux {
		groups = "GPIO16", "GPIO17", "GPIO18", "GPIO19", "GPIO20", "GPIO21", "GPIO22";
		function = "sdio2";
		drive-strength = <7>;
	};

	spi5_pmux: spi5-pmux {
		groups = "GPIO37", "GPIO38", "GPIO41";
		function = "spi5";
	};

	spi5_ss2_pmux: spi5-ss2-pmux {
		groups = "GPIO40";
		function = "gpio";
	};

	uart5_pmux: uart5-pmux {
		groups = "GPIO25", "GPIO26";
		function = "uart5";
		drive-strength = <7>;
	};

	usb_host_pwr_en_pmux: usb-host-pwr-en-pmux {
		groups = "GPIO54";
		function = "gpio";
	};

	user_button_pmux: user-button-pmux {
		groups = "GPIO58";
		function = "gpio";
	};

	vmmc_sdhci2_pmux: vmmc-sdhci2-pmux {
		groups = "GPIO53";
		function = "gpio";
	};

	vqmmc_sdhci2_pmux: vqmmc-sdhci2-pmux {
		groups = "GPIO55";
		function = "gpio";
	};

	w_disable1_pmux: w-disable1-pmux {
		groups = "GPIO48";
		function = "gpio";
	};

	w_disable2_pmux: w-disable2-pmux {
		groups = "GPIO50";
		function = "gpio";
	};
};

&porta {
	gpio-line-names =
		"", "", "", "SDIO_RSTn", "", "", "", "",
		"", "CSI_GPIO0", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "";
};

&portb {
	gpio-line-names =
		"", "", "", "", "", "", "", "",
		"SPI5_SS2", "", "GPIO42", "", "GPIO44", "GPIO45", "POWER_SOURCE", "GPIO47",
		"W_DISABLE1n", "M2_SDIO_HOST_WAKEn", "W_DISABLE2n", "USB_HOST_OCSn", "", "USD_PWR_EN", "USB_HOST_POWER_EN", "USD_VSEL",
		"GPIO56", "WAKEUPn", "USER_BUTTONn", "", "", "", "", "";
};

&portc {
	gpio-line-names =
		"", "", "", "", "", "VCORE_ONn", "SM_SPI1_SS3", "",
		"", "", "", "", "", "", "LED_1", "LED_2";
};

&porte {
	gpio-line-names =
		"", "", "", "SM_GPIO27", "", "", "CSI_GPIO1", "";
};

&portf {
	gpio-line-names =
		"", "", "SM_GPIO34", "", "", "", "", "";
};

&sdhci1 {
	status = "okay";
	bus-width = <4>;
	sdclkdl-dc = /bits/ 8 <50>;
	pad-sp = /bits/ 8 <12>;
	pad-sn = /bits/ 8 <12>;
	no-sd;
	no-mmc;
	non-removable;
	mmc-pwrseq = <&sdhci1_pwrseq>;
	mode1-tune;
	keep-power-in-suspend;
};

&sdhci2 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&sdhci2_pmux>;
	bus-width = <4>;
	no-mmc;
	disable-wp;
	cap-sd-highspeed;
	sd-uhs-sdr12;
	sd-uhs-sdr25;
	sd-uhs-sdr50;
	sd-uhs-sdr104;
	vmmc-supply = <&vmmc_sdhci2>;
	vqmmc-supply = <&vqmmc_sdhci2>;
	mux-states = <&mux0 0 3>;
};

&sm_pinctrl {
	csi_gpio1_pmux: csi-gpio1-pmux {
		groups = "SM_GPIO30";
		function = "gpio";
	};

	i2c0_pmux: i2c0-pmux {
		groups = "SM_GPIO37", "SM_GPIO38";
		function = "tw0";
		drive-strength = <7>;
	};

	led_1_pmux: led-1-pmux {
		groups = "SM_GPIO14";
		function = "gpio";
	};

	led_2_pmux: led-2-pmux {
		groups = "SM_GPIO15";
		function = "gpio";
	};

	spi1_pmux: spi1-pmux {
		groups = "SM_GPIO9", "SM_GPIO10", "SM_GPIO11";
		function = "spi1";
	};

	spi1_ss3_pmux: spi1-ss3-pmux {
		groups = "SM_GPIO6";
		function = "gpio";
	};

	uart1_pmux: uart1-pmux {
		groups = "SM_GPIO31", "SM_GPIO32", "SM_GPIO35", "SM_GPIO36";
		function = "uart1";
		drive-strength = <7>;
	};

	uart3_pmux: uart3-pmux {
		groups = "SM_GPIO28", "SM_GPIO29";
		function = "uart3";
		drive-strength = <7>;
	};
};

&smmu {
	status = "okay";
};

&spi1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&spi1_pmux>, <&spi1_ss3_pmux>;

	cs-gpios = <&portc 6 GPIO_ACTIVE_LOW>;
};

&spi5 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&spi5_pmux>, <&spi5_ss2_pmux>;

	cs-gpios = <&portb 8 GPIO_ACTIVE_LOW>;
};

&synpu {
	status = "okay";
};

&uart0 {
	status = "okay";
};

&uart1 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_pmux>;
	/delete-property/ dmas;
	/delete-property/ dma-names;
};

&uart3 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart3_pmux>;
};

&uart5 {
	status = "okay";
	pinctrl-names = "default";
	pinctrl-0 = <&uart5_pmux>;
};

&usb0 {
	status = "okay";
	dr_mode = "peripheral";
};

&usb_phy0 {
	status = "okay";
};

&usb1 {
	status = "okay";
	vbus-supply = <&usb1_vbus>;
	dr_mode = "host";
};

&usb_phy1 {
	status = "okay";
};

&vpp {
    status = "okay";
    enable_ampless_boot = <1>;
};
