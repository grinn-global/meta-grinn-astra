#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	chosen {
		stdout-path = "serial0:115200n8";
	};

	keys {
		compatible = "gpio-keys";
		status = "okay";

		user-button {
			pinctrl-names = "default";
			pinctrl-0 = <&user_button_pmux>;
			label = "Enter Button";
			linux,code = <KEY_ENTER>;
			gpios = <&portb 26 GPIO_ACTIVE_LOW>;
			debounce-interval = <50>;
		};
	};

	regulators {
		compatible = "simple-bus";
		#address-cells = <1>;
		#size-cells = <0>;

		usb1_vbus: usb1-vbus {
			compatible = "regulator-fixed";
			pinctrl-names = "default";
			pinctrl-0 = <&usb_host_pwr_en_pmux>;
			regulator-name = "usb1_vbus";
			regulator-min-microvolt = <5000000>;
			regulator-max-microvolt = <5000000>;
			gpio = <&portb 22 GPIO_ACTIVE_HIGH>;
			enable-active-high;
		};
	};
};

&pinctrl {
	usb_host_pwr_en_pmux: usb-host-pwr-en-pmux {
		groups = "GPIO54";
		function = "gpio";
	};

	user_button_pmux: user-button-pmux {
		groups = "GPIO58";
		function = "gpio";
	};
};

&portb {
	gpio-line-names =
		"", "", "", "", "", "", "", "",
		"", "", "", "", "", "", "", "",
		"", "", "", "USB_HOST_OCSn", "", "", "USB_HOST_POWER_EN", "",
		"", "", "USER_BUTTONn", "", "", "", "", "";
};

&uart0 {
	status = "okay";
};

&usb0 {
	status = "okay";
	dr_mode = "peripheral";
};

&usb_phy0 {
	status = "okay";
};

&usb1 {
	status = "okay";
	vbus-supply = <&usb1_vbus>;
	dr_mode = "host";
};

&usb_phy1 {
	status = "okay";
};
