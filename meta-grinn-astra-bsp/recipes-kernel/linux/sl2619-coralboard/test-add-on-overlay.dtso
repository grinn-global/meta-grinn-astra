/dts-v1/;
/plugin/;

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/leds/common.h>

/ {
	compatible = "syna,sl2619-coralboard", "syna,sl2619";
};

&{/leds} {
	tst_led_blue: tst-led-blue {
		color = <LED_COLOR_ID_BLUE>;
		default-state = "off";
		function = LED_FUNCTION_STATUS;
		gpios = <&gpio_expander 6 GPIO_ACTIVE_HIGH>;
		label = "test-add-on-led-blue";
	};

	tst_led_green: tst-led-green {
		color = <LED_COLOR_ID_GREEN>;
		default-state = "on";
		function = LED_FUNCTION_STATUS;
		gpios = <&gpio_expander 5 GPIO_ACTIVE_HIGH>;
		label = "test-add-on-led-green";
	};

	tst_led_red: tst-led-red {
		color = <LED_COLOR_ID_RED>;
		default-state = "off";
		function = LED_FUNCTION_STATUS;
		gpios = <&gpio_expander 3 GPIO_ACTIVE_HIGH>;
		label = "test-add-on-led-red";
	};

	tst_led_yellow: tst-led-yellow {
		color = <LED_COLOR_ID_YELLOW>;
		default-state = "off";
		function = LED_FUNCTION_STATUS;
		gpios = <&gpio_expander 4 GPIO_ACTIVE_HIGH>;
		label = "test-add-on-led-yellow";
	};
};

&drm {
	dsi_hdmi_lt9611_bridge {
		compatible = "syna-bridge,lt9611";
		enable-gpio = <&gpio_expander 2 GPIO_ACTIVE_HIGH>;
		reset-gpio = <&gpio_expander 0 GPIO_ACTIVE_LOW>;
		i2c_bus = <3>;
	};

	dsi_panel {
		status = "okay";
		/*
		 * Neutralize the dsi panel settings inherited from
		 * sl261x-coralboard-common.dtsi. Standalone runtime overlays cannot
		 * delete base-tree properties, so overwrite the phandle properties
		 * with empty values instead.
		 */
		power-supply = <>;
		backlight = <>;
		compatible_panel = "";

		ACTIVE_WIDTH = <1920>;
		HFP = <88>;
		HSYNCWIDTH = <44>;
		HBP = <148>;
		ACTIVE_HEIGHT = <1080>;
		VFP = <4>;
		VSYNCWIDTH = <5>;
		VBP = <36>;
		FREQ = <148500>;
		PIXEL_CLOCK = <148500>;
		bits_per_pixel = <24>;
		busformat = <0>;

		HTOTAL = <2200>;
		Lanes = /bits/ 8 <4>;
		Vid_mode = /bits/ 8 <2>;
		virtual_chan = /bits/ 8 <0>;
		Clk_Lane_Polarity = /bits/ 8 <0>;
		Data_Lane_Polarity = /bits/ 8 <0>;
		Recv_ack = /bits/ 8 <0>;
		Loosely_18 = /bits/ 8 <0>;
		H_polarity = /bits/ 8 <1>;
		V_Polarity = /bits/ 8 <1>;
		Data_Polarity = /bits/ 8 <1>;
		Eotp_tx = /bits/ 8 <1>;
		Eotp_rx = /bits/ 8 <0>;
		non-Continuous_clk = /bits/ 8 <0>;
		dpi_lp_cmd = /bits/ 8 <1>;
		Color_coding = /bits/ 8 <5>;
		Chunks = <0>;
		Null_Pkt = <0>;
		Byte_clk = <148500>;

		command = /bits/ 8 <0xFF 0x10 0x27 0x00 0x00>;
	};
};

&i2c3 {
	#address-cells = <1>;
	#size-cells = <0>;

	ft5406: ts@38 {
		status = "disabled";
	};

	gpio_expander: gpio@44 {
		compatible = "fcs,fxl6408";
		reg = <0x44>;
		gpio-controller;
		#gpio-cells = <2>;
		gpio-line-names =
			"TST_HDMI_RSTn",
			"TST_TP1",
			"TST_HDMI_PWR_EN",
			"TST_LED_RED",
			"TST_LED_YELLOW",
			"TST_LED_GREEN",
			"TST_LED_BLUE",
			"TST_BUZZER";
	};

	power-monitor@40 {
		compatible = "ti,ina4230";
		reg = <0x40>;
		channel-labels = "VBAT", "VBOOST",
				 "SOM_5V", "TST_VBUS";
		shunt-resistor = <10000 10000 10000 10000>;
		shunt-gain = <4 1 1 4>;
	};

	power-monitor@41 {
		compatible = "ti,ina4230";
		reg = <0x41>;
		channel-labels = "20P_3V3", "20P_5V",
				 "CSI_3V3", "MB_5V";
		shunt-resistor = <100000 100000 100000 100000>;
		shunt-gain = <4 4 4 4>;
	};

	power-monitor@45 {
		compatible = "ti,ina4230";
		reg = <0x45>;
		channel-labels = "UNUSED", "20P_1V8",
				 "I3C_1V8", "MB_3V3";
		shunt-resistor = <100000 100000 100000 100000>;
		shunt-gain = <4 4 4 4>;
	};

	power-monitor@4d {
		compatible = "ti,ina4230";
		reg = <0x4d>;
		channel-labels = "VUSB_HOST", "SD_3V3",
				 "M2E_3V3", "QWIIC_3V3";
		shunt-resistor = <10000 100000 10000 100000>;
		shunt-gain = <1 1 1 4>;
	};

	rpi_panel_regulator: rpi_panel_regulator@45 {
		status = "disabled";
	};
};
